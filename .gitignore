# Runtime state — logs
state/factory.log.jsonl

# SQLite runtime state (factory + sample-project data DBs are regenerated, never committed)
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Per-project secrets (legacy in-repo layout)
projects/*/.secrets/
projects/*/.secrets/*

# Factory-generated PROJECTS are the factory's OUTPUT, not part of the factory.
# They live in $FACTORY_HOME/projects/<slug>/ (default ~/.factory), OUTSIDE this
# repo, and each product directory IS its own git repository carrying its whole
# artifact chain (INTENT/SPEC/PLAN, ADRs, releases, PROJECT_RULES, project-spec)
# together WITH its code. `projects/` stays ignored for the legacy in-repo layout
# until `factory workspace import-legacy <dir>` has moved it.
projects/
# Default/scratch working tree the factory materializes into when no project is set.
repo/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/

# Node (in case opencode pulls anything in)
node_modules/

# Claude Code: git worktrees created for parallel agents (always transient)
.claude/worktrees/

# OS / editors
.DS_Store
.idea/
.vscode/
*.swp
*.swo

# uv
.uv-cache/

# opencode: only the `.opencode/agents -> ../agents` symlink is versioned. Plugin
# deps opencode installs here are covered by .opencode/.gitignore.
.opencode/state/
.opencode/cache/

# CI eval report (`factory evals --report eval-report.md`)
eval-report.md

# Generated reports (`factory visualize`, `factory metrics --report`) are output, not source.
reports/
*-visualization.html
