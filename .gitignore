# Runtime state — file-backed DBs, logs, queues
state/*.duckdb
state/*.duckdb.wal
state/factory.log.jsonl

# SQLite runtime state (factory + sample-project data DBs are regenerated, never committed)
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Per-project runtime state and live workspaces
projects/*/state/*.duckdb
projects/*/state/*.duckdb.wal
projects/*/.secrets/
projects/*/.secrets/*

# Factory-generated PROJECTS are the factory's OUTPUT, not part of the factory.
# Each product owns its own lifecycle and must carry its whole artifact chain
# (INTENT/SPEC/PLAN, ADRs, PROJECT_RULES, project-spec) together WITH its code —
# tracking the docs here and the code in repo/ split every product's audit trail
# across two repositories. Nothing under a projects/ folder is versioned here.
projects/
mvp/projects/
# Default/scratch working tree the factory materializes into when no project is set.
mvp/repo/
repo/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/

# Node (in case opencode pulls anything in)
node_modules/

# OS / editors
.DS_Store
.idea/
.vscode/
*.swp
*.swo

# uv
.uv-cache/

# opencode local state if any
.opencode/state/
.opencode/cache/

# Generated reports (`factory visualize`, `factory metrics --report`) are output, not source.
reports/
*-visualization.html
